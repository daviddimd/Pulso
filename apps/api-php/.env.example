CI_ENVIRONMENT = production
app.baseURL = 'https://pulso.institucion.cl/'
app.appTimezone = UTC
app.forceGlobalSecureRequests = true

database.default.hostname = 127.0.0.1
database.default.port = 3306
database.default.database = pulso
database.default.username = pulso
database.default.password = 'CONFIGURAR_EN_EL_SERVIDOR'
database.default.DBDriver = MySQLi

# Interfaz y API bajo el mismo origen; no se requiere CORS externo.
CORS_ORIGIN = ''
PULSO_SESSION_TTL_HOURS = 12
FRONTEND_URL = 'https://pulso.institucion.cl/'
CLAVE_UNICA_CLIENT_ID = ''
CLAVE_UNICA_CLIENT_SECRET = ''
CLAVE_UNICA_REDIRECT_URI = 'https://pulso.institucion.cl/api/auth/clave-unica/callback'
