generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  ADMIN
}

enum BitacoraStatus {
  OPEN
  COMPLETED
  VOIDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  fullName     String   @map("full_name") @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)

  role   UserRole
  active Boolean  @default(true)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  bitacoras BitacoraEntry[] @relation("DriverBitacoras")
  auditLogs AuditLog[]      @relation("AuditActor")

  @@map("users")
}

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  roleCode     String @unique @map("role_code") @db.VarChar(30)
  licensePlate String @unique @map("license_plate") @db.VarChar(20)

  currentOdometerKm Int? @map("current_odometer_km")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bitacoras BitacoraEntry[]

  @@map("vehicles")
}

model BitacoraEntry {
  id String @id @default(uuid()) @db.Uuid

  driverId  String @map("driver_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  status BitacoraStatus @default(OPEN)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  serviceAddress  String @map("service_address") @db.VarChar(350)
  actionPerformed String @map("action_performed") @db.VarChar(250)

  odometerKm Int? @map("odometer_km")

  voidReason String? @map("void_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver User @relation("DriverBitacoras", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

    @@index([driverId, startedAt])
    @@index([vehicleId, startedAt])
    @@index([status, startedAt])

    @@map("bitacora_entries")
  }

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])

  @@map("sessions")
}

model AuditLog {
  id BigInt @id @default(autoincrement())

  actorUserId String? @map("actor_user_id") @db.Uuid

  entityType String @map("entity_type") @db.VarChar(60)
  entityId   String @map("entity_id") @db.VarChar(80)

  action String @db.VarChar(80)

  beforeData Json? @map("before_data")
  afterData  Json? @map("after_data")

  ipAddress String? @map("ip_address") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])

  @@map("audit_logs")
}