      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Reportar_f5</bpmn:incoming>
      <bpmn:incoming>Reportar_f6</bpmn:incoming>
      <bpmn:outgoing>Reportar_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Reportar_fin" name="Reporte descargado">
