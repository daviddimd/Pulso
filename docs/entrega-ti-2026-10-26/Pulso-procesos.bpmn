      <bpmn:incoming>Reportar_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Reportar_f0" sourceRef="Reportar_s" targetRef="Reportar_periodo" name="" />
    <bpmn:sequenceFlow id="Reportar_f1" sourceRef="Reportar_periodo" targetRef="Reportar_consulta" name="" />
    <bpmn:sequenceFlow id="Reportar_f2" sourceRef="Reportar_consulta" targetRef="Reportar_tipoQ" name="" />
    <bpmn:sequenceFlow id="Reportar_f3" sourceRef="Reportar_tipoQ" targetRef="Reportar_excel" name="Excel" />
    <bpmn:sequenceFlow id="Reportar_f4" sourceRef="Reportar_tipoQ" targetRef="Reportar_pdf" name="PDF" />
    <bpmn:sequenceFlow id="Reportar_f5" sourceRef="Reportar_excel" targetRef="Reportar_unir" name="" />
    <bpmn:sequenceFlow id="Reportar_f6" sourceRef="Reportar_pdf" targetRef="Reportar_unir" name="" />
    <bpmn:sequenceFlow id="Reportar_f7" sourceRef="Reportar_unir" targetRef="Reportar_fin" name="" />
  </bpmn:process>
