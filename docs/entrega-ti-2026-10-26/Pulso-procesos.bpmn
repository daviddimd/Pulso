      <bpmn:outgoing>Reportar_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Reportar_excel" name="Navegador: generar Excel con SheetJS">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Reportar_f3</bpmn:incoming>
      <bpmn:outgoing>Reportar_f5</bpmn:outgoing>
    </bpmn:serviceTask>
