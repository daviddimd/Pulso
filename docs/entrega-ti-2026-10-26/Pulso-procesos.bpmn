<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PulsoDefinitions" targetNamespace="https://pulso.local/modelos" exporter="Pulso / entrega TI" exporterVersion="1.0">
  <bpmn:process id="Preparar" name="Registro, asignación e inicio" isExecutable="false">
    <bpmn:startEvent id="Preparar_s" name="Necesidad de traslado">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:outgoing>Preparar_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Preparar_crear" name="Usuario: registrar destino, actividad y CC">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f0</bpmn:incoming>
      <bpmn:outgoing>Preparar_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Preparar_guardar" name="Sistema: guardar PENDING / ASSIGNED">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f1</bpmn:incoming>
      <bpmn:outgoing>Preparar_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Preparar_cancelarQ" name="¿Cancelar antes de iniciar?">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f2</bpmn:incoming>
      <bpmn:incoming>Preparar_f7</bpmn:incoming>
      <bpmn:outgoing>Preparar_f3</bpmn:outgoing>
      <bpmn:outgoing>Preparar_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Preparar_cancelar" name="Admin: cancelar con motivo">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f3</bpmn:incoming>
      <bpmn:outgoing>Preparar_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Preparar_cancelado" name="CANCELLED">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Preparar_asignadoQ" name="¿Chofer asignado?">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f5</bpmn:incoming>
      <bpmn:outgoing>Preparar_f6</bpmn:outgoing>
      <bpmn:outgoing>Preparar_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Preparar_asignar" name="Admin: asignar chofer / vehículo">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f6</bpmn:incoming>
      <bpmn:outgoing>Preparar_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Preparar_iniciar" name="Chofer: iniciar con vehículo">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f8</bpmn:incoming>
      <bpmn:incoming>Preparar_f12</bpmn:incoming>
      <bpmn:outgoing>Preparar_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Preparar_validar" name="Sistema: validar recursos y odómetro inicial">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f9</bpmn:incoming>
      <bpmn:outgoing>Preparar_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Preparar_validoQ" name="¿Disponible y lectura conocida?">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f10</bpmn:incoming>
      <bpmn:outgoing>Preparar_f11</bpmn:outgoing>
      <bpmn:outgoing>Preparar_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Preparar_curso" name="IN_PROGRESS Tramo abierto">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Preparar_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Preparar_f0" sourceRef="Preparar_s" targetRef="Preparar_crear" name="" />
    <bpmn:sequenceFlow id="Preparar_f1" sourceRef="Preparar_crear" targetRef="Preparar_guardar" name="" />
    <bpmn:sequenceFlow id="Preparar_f2" sourceRef="Preparar_guardar" targetRef="Preparar_cancelarQ" name="" />
    <bpmn:sequenceFlow id="Preparar_f3" sourceRef="Preparar_cancelarQ" targetRef="Preparar_cancelar" name="Sí" />
    <bpmn:sequenceFlow id="Preparar_f4" sourceRef="Preparar_cancelar" targetRef="Preparar_cancelado" name="" />
    <bpmn:sequenceFlow id="Preparar_f5" sourceRef="Preparar_cancelarQ" targetRef="Preparar_asignadoQ" name="No" />
    <bpmn:sequenceFlow id="Preparar_f6" sourceRef="Preparar_asignadoQ" targetRef="Preparar_asignar" name="No" />
    <bpmn:sequenceFlow id="Preparar_f7" sourceRef="Preparar_asignar" targetRef="Preparar_cancelarQ" name="Revisar" />
    <bpmn:sequenceFlow id="Preparar_f8" sourceRef="Preparar_asignadoQ" targetRef="Preparar_iniciar" name="Sí" />
    <bpmn:sequenceFlow id="Preparar_f9" sourceRef="Preparar_iniciar" targetRef="Preparar_validar" name="" />
    <bpmn:sequenceFlow id="Preparar_f10" sourceRef="Preparar_validar" targetRef="Preparar_validoQ" name="" />
    <bpmn:sequenceFlow id="Preparar_f11" sourceRef="Preparar_validoQ" targetRef="Preparar_curso" name="Sí" />
    <bpmn:sequenceFlow id="Preparar_f12" sourceRef="Preparar_validoQ" targetRef="Preparar_iniciar" name="No: corregir / esperar" />
  </bpmn:process>
  <bpmn:process id="Ejecutar" name="Recorrido, eventual relevo y finalización" isExecutable="false">
    <bpmn:startEvent id="Ejecutar_s" name="IN_PROGRESS">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:outgoing>Ejecutar_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Ejecutar_recorrer" name="Chofer: realizar el servicio">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f0</bpmn:incoming>
      <bpmn:incoming>Ejecutar_f4</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Ejecutar_relevoQ" name="¿Se necesita reasignación?">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f1</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f2</bpmn:outgoing>
      <bpmn:outgoing>Ejecutar_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Ejecutar_reasignar" name="Admin: elegir recursos y registrar km del relevo">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f2</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Ejecutar_reabrir" name="Sistema: cerrar tramo y abrir el nuevo">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f3</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Ejecutar_finalizar" name="Chofer: finalizar con odómetro de llegada">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f5</bpmn:incoming>
      <bpmn:incoming>Ejecutar_f8</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Ejecutar_validar" name="Sistema: validar lecturas de kilometraje">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f6</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Ejecutar_validoQ" name="¿Lectura válida?">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f7</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f8</bpmn:outgoing>
      <bpmn:outgoing>Ejecutar_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Ejecutar_cerrar" name="Sistema: cerrar tramo, actualizar km y auditar">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f9</bpmn:incoming>
      <bpmn:outgoing>Ejecutar_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Ejecutar_fin" name="COMPLETED">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
      <bpmn:incoming>Ejecutar_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Ejecutar_f0" sourceRef="Ejecutar_s" targetRef="Ejecutar_recorrer" name="" />
    <bpmn:sequenceFlow id="Ejecutar_f1" sourceRef="Ejecutar_recorrer" targetRef="Ejecutar_relevoQ" name="" />
    <bpmn:sequenceFlow id="Ejecutar_f2" sourceRef="Ejecutar_relevoQ" targetRef="Ejecutar_reasignar" name="Sí" />
    <bpmn:sequenceFlow id="Ejecutar_f3" sourceRef="Ejecutar_reasignar" targetRef="Ejecutar_reabrir" name="" />
    <bpmn:sequenceFlow id="Ejecutar_f4" sourceRef="Ejecutar_reabrir" targetRef="Ejecutar_recorrer" name="Continuar" />
    <bpmn:sequenceFlow id="Ejecutar_f5" sourceRef="Ejecutar_relevoQ" targetRef="Ejecutar_finalizar" name="No" />
    <bpmn:sequenceFlow id="Ejecutar_f6" sourceRef="Ejecutar_finalizar" targetRef="Ejecutar_validar" name="" />
    <bpmn:sequenceFlow id="Ejecutar_f7" sourceRef="Ejecutar_validar" targetRef="Ejecutar_validoQ" name="" />
    <bpmn:sequenceFlow id="Ejecutar_f8" sourceRef="Ejecutar_validoQ" targetRef="Ejecutar_finalizar" name="No: corregir" />
    <bpmn:sequenceFlow id="Ejecutar_f9" sourceRef="Ejecutar_validoQ" targetRef="Ejecutar_cerrar" name="Sí" />
    <bpmn:sequenceFlow id="Ejecutar_f10" sourceRef="Ejecutar_cerrar" targetRef="Ejecutar_fin" name="" />
  </bpmn:process>
  <bpmn:process id="Reportar" name="Reportes de servicios y centros de costos" isExecutable="false">
    <bpmn:startEvent id="Reportar_s" name="Necesidad de reporte">
      <bpmn:documentation>Actor indicado en el nombre. Modelo descriptivo del código actual, no motor de ejecución.</bpmn:documentation>
